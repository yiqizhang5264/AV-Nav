+def parse_vqa_binary_answer(answer: str) -> str:
+    """Parse a yes/no VQA answer without matching words in its reasoning."""
+    explicit = re.search(
+        r"(?im)^\s*(?:\*\*)?answer(?:\*\*)?\s*:\s*(?:\*\*)?\s*(yes|no)\b",
+        answer,
+    )
+    if explicit:
+        return explicit.group(1).lower()
+
+    nonempty_lines = [line.strip() for line in answer.splitlines() if line.strip()]
+    if nonempty_lines:
+        final_line = re.fullmatch(
+            r"[\s*_`]*(yes|no)[\s*_`.!]*",
+            nonempty_lines[-1],
+            re.IGNORECASE,
+        )
+        if final_line:
+            return final_line.group(1).lower()
+
+    raise ValueError("VQA response has no unambiguous yes/no final answer")
+
